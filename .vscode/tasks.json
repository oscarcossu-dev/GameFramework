{
    "tasks": [
        {
            "type": "cppbuild",
            "label": "C/C++: cl.exe build active file",
            "command": "cl.exe",
            "args": [
                "/Zi",
                "/EHsc",
                "/nologo",
                "/std:c++17",
                "*.cpp",
                "/I${fileDirname}\\SFML-2.6.2\\include",
                "/link",
                "/LIBPATH:${fileDirname}\\SFML-2.6.2\\lib",
                "sfml-system.lib", "sfml-window.lib", "sfml-graphics.lib",
                "/OUT:${fileDirname}\\build\\debug\\test_game.exe",
                
            ],
            "options": {
                "cwd": "${fileDirname}"
            },
            "problemMatcher": [
                "$msCompile"
            ],
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "detail": "Task generated by Debugger."
        }
        ,
        {
            "type": "cppbuild",
            "label": "C/C++: cl.exe + SFML3 build active file",
            "command": "cl.exe",
            "args": [
                "/Zi",
                "/EHsc",
                "/nologo",
                "/std:c++17",
                "${file}",
                "/I${fileDirname}\\SFML3.0.2\\include",
                "/link",
                "/LIBPATH:${fileDirname}\\SFML3.0.2\\lib",
                "sfml-system.lib", "sfml-window.lib", "sfml-graphics.lib",
                "/OUT:${fileDirname}\\build3\\${fileBasenameNoExtension}.exe",
                
            ],
            "options": {
                "cwd": "${fileDirname}"
            },
            "problemMatcher": [
                "$msCompile"
            ],
            "group": {
                "kind": "build",
                "isDefault": false
            },
            "detail": "Task generated by Debugger."
        }
        ,
         {
            "label": "echo",
            "type": "shell",
            "command": "echo ${workspaceFolder} ${fileDirname}"
        }
    ],
    "version": "2.0.0"
}